{
    "name": "phatnt93/php-excel-helper",
    "description": "Read and write Excel/spreadsheet files (xlsx, xls, ods, csv) with simple array configuration: start row/column, typed columns, defaults, row-level validation errors, styled exports. Built on PhpSpreadsheet.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Phat Nguyen",
            "email": "phatnt93@gmail.com"
        }
    ],
    "keywords": [
        "excel",
        "xlsx",
        "xls",
        "ods",
        "csv",
        "spreadsheet",
        "phpspreadsheet",
        "excel-import",
        "excel-export",
        "excel-reader",
        "excel-writer",
        "import",
        "export",
        "array-to-excel",
        "excel-to-array"
    ],
    "homepage": "https://github.com/phatnt93/php-excel-helper",
    "readme": "README.md",
    "support": {
        "issues": "https://github.com/phatnt93/php-excel-helper/issues",
        "source": "https://github.com/phatnt93/php-excel-helper",
        "docs": "https://github.com/phatnt93/php-excel-helper#readme"
    },
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "phpoffice/phpspreadsheet": "^5.8"
    },
    "suggest": {
        "ext-intl": "Unicode NFC normalization when matching columns by header text"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "ExcelHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExcelHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=coverage/clover.xml",
            "@php tests/coverage-check.php coverage/clover.xml 90"
        ],
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
